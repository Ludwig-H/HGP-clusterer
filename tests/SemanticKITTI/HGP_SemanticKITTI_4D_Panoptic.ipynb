        "## 2. Chargement des Données"
      ],
      "metadata": {
        "id": "data_title"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Téléchargement des séquences SemanticKITTI
",
        "# Lien dossier Drive fourni : https://drive.google.com/drive/folders/1ORVzSo-TWbNHeAC0-k3mxX9AiJHI_tVu
",
        "folder_id = "1ORVzSo-TWbNHeAC0-k3mxX9AiJHI_tVu"
",
        "
",
        "print("Téléchargement des données depuis Google Drive (cela peut prendre du temps)...")
",
        "!gdown --folder {folder_id} -O /content/semantic_kitti_data --quiet
",
        "print("Téléchargement terminé.")
",
        "
",
        "!ls -R /content/semantic_kitti_data | head -n 20"
      ],
      "metadata": {
        "id": "download_data"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Classe utilitaire pour SemanticKITTI
",
        "import os
",
        "import numpy as np
",
        "import glob
",
        "
",
        "class SemanticKITTILoader:
",
        "    def __init__(self, base_path, sequence_num):
",
        "        self.seq_str = f"{sequence_num:02d}"
",
        "        # Recherche flexible du chemin (au cas où la structure gdown varie)
",
        "        possible_paths = glob.glob(f"{base_path}/**/sequences/{self.seq_str}", recursive=True)
",
        "        if not possible_paths:
",
        "             # Essayer structure directe
",
        "             possible_paths = glob.glob(f"{base_path}/{self.seq_str}", recursive=True)
",
        "        
",
        "        if not possible_paths:
",
        "            raise ValueError(f"Séquence {self.seq_str} introuvable dans {base_path}")
",
        "            
",
        "        self.seq_path = possible_paths[0]
",
        "        print(f"Séquence chargée depuis : {self.seq_path}")
",
        "        
",
        "        self.velo_path = os.path.join(self.seq_path, 'velodyne')
",
        "        self.label_path = os.path.join(self.seq_path, 'labels')
",
        "        self.poses_file = os.path.join(self.seq_path, 'poses.txt')
",
        "        self.calib_file = os.path.join(self.seq_path, 'calib.txt')
",
        "        
",
        "        self.scan_files = sorted(glob.glob(os.path.join(self.velo_path, '*.bin')))
",
        "        self.label_files = sorted(glob.glob(os.path.join(self.label_path, '*.label')))
",
        "        self.poses = self._load_poses()
",
        "        self.calib = self._load_calib()
",
        "        
",
        "    def _load_poses(self):
",
        "        if not os.path.exists(self.poses_file):
",
        "            print("⚠️ Fichier poses.txt absent. Les coordonnées seront locales au capteur.")
",
        "            return []
",
        "        
",
        "        poses = []
",
        "        with open(self.poses_file, 'r') as f:
",
        "            for line in f:
",
        "                values = [float(v) for v in line.strip().split()]
",
        "                pose = np.array(values).reshape(3, 4)
",
        "                # Ajout ligne [0,0,0,1] pour matrice 4x4
",
        "                pose_4x4 = np.vstack([pose, [0, 0, 0, 1]])
",
        "                poses.append(pose_4x4)
",
        "        return poses
",
        "
",
        "    def _load_calib(self):
",
        "        if not os.path.exists(self.calib_file):
",
        "            return np.eye(4)
",
        "        
",
        "        calib = {}
",
        "        with open(self.calib_file, 'r') as f:
",
        "            for line in f:
",
        "                key, val = line.split(':', 1)
",
        "                calib[key] = np.array([float(x) for x in val.split()]).reshape(3, 4)
",
        "        
",
        "        # Transformation Tr (Velodyne -> Cam0) généralement utilisée
",
        "        Tr = np.vstack([calib['Tr'], [0, 0, 0, 1]])
",
        "        return Tr
",
        "
",
        "    def get_scan(self, idx, apply_pose=True):
",
        "        file_path = self.scan_files[idx]
",
        "        scan = np.fromfile(file_path, dtype=np.float32).reshape(-1, 4)
",
        "        points = scan[:, :3]
",
        "        remissions = scan[:, 3]
",
        "        
",
        "        if apply_pose and self.poses:
",
        "            # Transformation vers World : Pose * Tr * Point
",
        "            # Note: Dans SemanticKITTI, les poses sont généralement Cam0 -> World
",
        "            # Tr est Velodyne -> Cam0
",
        "            # Donc Global = Pose * Tr * Local
",
        "            
",
        "            Tr = self.calib
",
        "            Pose = self.poses[idx]
",
        "            T_global = Pose @ Tr
",
        "            
",
        "            # Homogeneous coords
",
        "            points_h = np.hstack([points, np.ones((points.shape[0], 1))])
",
        "            points_world = (T_global @ points_h.T).T
",
        "            points = points_world[:, :3]
",
        "            
",
        "        return points, remissions
",
        "
",
        "    def get_labels(self, idx):
",
        "        if idx >= len(self.label_files):
",
        "            return None
",
        "        label_path = self.label_files[idx]
",
        "        label = np.fromfile(label_path, dtype=np.uint32)
",
        "        sem_label = label & 0xFFFF
",
        "        inst_label = label >> 16
",
        "        return sem_label, inst_label
",
        "
",
        "    def __len__(self):
",
        "        return len(self.scan_files)"
      ],
      "metadata": {
        "id": "loader_class"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 3. Préparation des Données 4D"
      ],
      "metadata": {
        "id": "prep_4d_title"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Configuration de la Séquence
",
        "SEQUENCE_ID = 8 # @param {type:"integer"}
",
        "START_FRAME = 0 # @param {type:"integer"}
",
        "NUM_FRAMES = 10 # @param {type:"integer"}
",
        "DT_SCALE = 5.0  # @param {type:"number"} # Facteur d'échelle pour le temps (alpha)
",
        "APPLY_BEV = False # @param {type:"boolean"}
",
        "APPLY_POSES = True # @param {type:"boolean"}
",
        "
",
        "try:
",
        "    loader = SemanticKITTILoader("/content/semantic_kitti_data", SEQUENCE_ID)
",
        "    print(f"Séquence {SEQUENCE_ID} chargée. {len(loader)} scans disponibles.")
",
        "except Exception as e:
",
        "    print(f"Erreur: {e}")
",
        "    # Fallback pour test si pas de données
",
        "    print("Utilisation de données synthétiques pour test si échec chargement.")"
      ],
      "metadata": {
        "id": "seq_config"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Construction du Nuage 4D
",
        "import numpy as np
",
        "
",
        "points_4d = []
",
        "labels_gt_sem = []
",
        "labels_gt_inst = []
",
        "times = []
",
        "
",
        "print(f"Accumulation des frames {START_FRAME} à {START_FRAME + NUM_FRAMES - 1}...")
",
        "
",
        "for i in range(NUM_FRAMES):
",
        "    frame_idx = START_FRAME + i
",
        "    if frame_idx >= len(loader):
",
        "        break
",
        "        
",
        "    pts, _ = loader.get_scan(frame_idx, apply_pose=APPLY_POSES)
",
        "    
",
        "    sem, inst = loader.get_labels(frame_idx)
",
        "    if sem is None:
",
        "        # Si pas de label, remplissage avec -1
",
        "        sem = np.full(pts.shape[0], -1, dtype=np.int32)
",
        "        inst = np.full(pts.shape[0], -1, dtype=np.int32)
",
        "        
",
        "    # Ajout dimension temporelle
",
        "    # t_val = i * DT_SCALE
",
        "    # Point 4D : [x, y, z, t]
",
        "    t_col = np.full((pts.shape[0], 1), i * DT_SCALE)
",
        "    pts_4d = np.hstack([pts, t_col])
",
        "    
",
        "    points_4d.append(pts_4d)
",
        "    labels_gt_sem.append(sem)
",
        "    labels_gt_inst.append(inst)
",
        "    times.extend([i] * pts.shape[0])
",
        "
",
        "X_4d = np.vstack(points_4d)
",
        "Y_sem = np.hstack(labels_gt_sem)
",
        "Y_inst = np.hstack(labels_gt_inst)
",
        "Time_idx = np.array(times)
",
        "
",
        "# Option BEV : Projection 2D + Temps = 3D pour le clustering (mais on garde l'info Z pour la viz)
",
        "if APPLY_BEV:
",
        "    print("Application Bird's Eye View (Z ignoré pour le clustering)...")
",
        "    # Clustering sur [x, y, t]
",
        "    X_clustering = X_4d[:, [0, 1, 3]]
",
        "else:
",
        "    # Clustering sur [x, y, z, t]
",
        "    X_clustering = X_4d
",
        "
",
        "print(f"Nuage 4D construit. Shape : {X_clustering.shape}")
",
        "print(f"Nombre total de points : {len(X_clustering)}")"
      ],
      "metadata": {
        "id": "build_4d"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 4. Clustering HGP"
      ],
      "metadata": {
        "id": "hgp_title"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Configuration HGP
",
        "
",
        "# Paramètres HGP
",
        "K = 5 # @param {type:"integer"}
",
        "MIN_CLUSTER_SIZE = 50 # @param {type:"integer"}
",
        "METRIC = "euclidean"
",
        "METHOD = "eom"
",
        "WEIGHT_FACE = "lambda" # @param ["lambda", "uniform", "unique"]
",
        "SUBSAMPLE = 0.5 # @param {type:"slider", min:0.1, max:1.0, step:0.1}
",
        "
",
        "# A priori géométriques
",
        "USE_SPLITTING = True # @param {type:"boolean"}
",
        "TAU = 0.6 # @param {type:"slider", min:0.0, max:1.0, step:0.05} # Seuil pureté
",
        "
",
        "def oracle_splitting_criterion(parent_indices, children_indices_list):
",
        "    """
",
        "    Fonction de splitting basée sur l'Oracle (Vérité Terrain).
",
        "    Vérifie si le split améliore la pureté des instances.
",
        "    """
",
        "    global Y_inst
",
        "    
",
        "    # 1. Pureté du père
",
        "    labels_parent = Y_inst[parent_indices]
",
        "    # Ignore les points sans instance (0 ou -1)
",
        "    labels_parent = labels_parent[labels_parent > 0]
",
        "    
",
        "    if len(labels_parent) == 0:
",
        "        purity_parent = 0.0
",
        "    else:
",
        "        _, counts = np.unique(labels_parent, return_counts=True)
",
        "        purity_parent = np.max(counts) / len(labels_parent)
",
        "        
",
        "    # 2. Pureté pondérée des enfants
",
        "    weighted_purity_children = 0.0
",
        "    total_points = 0
",
        "    
",
        "    for child_idx in children_indices_list:
",
        "        labels_child = Y_inst[child_idx]
",
        "        labels_child = labels_child[labels_child > 0]
",
        "        
",
        "        n_child = len(labels_child)
",
        "        if n_child > 0:
",
        "            _, counts_c = np.unique(labels_child, return_counts=True)
",
        "            purity_c = np.max(counts_c) / n_child
",
        "            weighted_purity_children += purity_c * n_child
",
        "            total_points += n_child
",
        "            
",
        "    if total_points == 0:
",
        "        purity_children = 0.0
",
        "    else:
",
        "        purity_children = weighted_purity_children / total_points
",
        "        
",
        "    # Décision
",
        "    # Si la pureté des enfants est significativement meilleure que celle du père
",
        "    # OU si le père a une pureté faible mais que les enfants sont purs
",
        "    gain = purity_children - purity_parent
",
        "    
",
        "    if purity_children > TAU and gain > 0.05:
",
        "        return True # Split !
",
        "    return False # Keep Parent
",
        "
",
        "splitting_func = oracle_splitting_criterion if USE_SPLITTING else None"
      ],
      "metadata": {
        "id": "hgp_config"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Exécution de HGPClusterer
",
        "import time
",
        "
",
        "print("Démarrage du clustering...")
",
        "t0 = time.time()
",
        "
",
        "clusterer = HGPClusterer(
",
        "    K=K,
",
        "    min_cluster_size=MIN_CLUSTER_SIZE,
",
        "    min_samples=K+1,
",
        "    metric=METRIC,
",
        "    method=METHOD,
",
        "    splitting=splitting_func,
",
        "    weight_face=WEIGHT_FACE,
",
        "    subsample=SUBSAMPLE,
",
        "    cgal_root=os.environ.get("CGALDELAUNAY_ROOT", "/content/HGP-clusterer/CGALDelaunay"),
",
        "    verbose=True
",
        ")
",
        "
",
        "labels_pred = clusterer.fit_predict(X_clustering)
",
        "dt = time.time() - t0
",
        "
",
        "n_clusters = len(set(labels_pred)) - (1 if -1 in labels_pred else 0)
",
        "print(f"
Clustering terminé en {dt:.2f} secondes.")
",
        "print(f"Clusters trouvés : {n_clusters}")"
      ],
      "metadata": {
        "id": "run_hgp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 5. Visualisation et Analyse"
      ],
      "metadata": {
        "id": "viz_title"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# @title Visualisation 3D/4D Interactive
",
        "import plotly.graph_objects as go
",
        "import numpy as np
",
        "
",
        "# Sous-échantillonnage pour la visualisation (pour ne pas crasher le navigateur)
",
        "viz_sample_rate = 10 
",
        "idx_viz = np.arange(0, len(X_4d), viz_sample_rate)
",
        "
",
        "X_viz = X_4d[idx_viz]
",
        "L_viz = labels_pred[idx_viz]
",
        "T_viz = Time_idx[idx_viz]
",
        "
",
        "# Palette de couleurs aléatoire pour les clusters
",
        "unique_labels = np.unique(L_viz)
",
        "colors = {}
",
        "for l in unique_labels:
",
        "    if l == -1:
",
        "        colors[l] = 'lightgray'
",
