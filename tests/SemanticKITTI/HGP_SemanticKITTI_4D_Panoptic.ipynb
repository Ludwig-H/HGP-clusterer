",
        "
",
        "fig = go.Figure()
",
        "
",
        "for l in unique_labels:
",
        "    mask = L_viz == l
",
        "    if np.sum(mask) == 0: continue
",
        "    
",
        "    # Nom du cluster avec info temporelle (span)
",
        "    t_span = T_viz[mask]
",
        "    name = f"C{l} (t={t_span.min()}-{t_span.max()})"
",
        "    
",
        "    fig.add_trace(go.Scatter3d(
",
        "        x=X_viz[mask, 0],
",
        "        y=X_viz[mask, 1],
",
        "        z=X_viz[mask, 2],
",
        "        mode='markers',
",
        "        marker=dict(
",
        "            size=2,
",
        "            color=colors[l],
",
        "            opacity=0.8
",
        "        ),
",
        "        name=name
",
        "    ))
",
        "
",
        "fig.update_layout(
",
        "    title=f"Segmentation Panoptique 4D (Séquence {SEQUENCE_ID})",
",
        "    scene=dict(
",
        "        xaxis_title='X',
",
        "        yaxis_title='Y',
",
        "        zaxis_title='Z',
",
        "        aspectmode='data'
",
        "    ),
",
        "    margin=dict(l=0, r=0, b=0, t=30),
",
        "    legend=dict(itemsizing='constant')
",
        ")
",
        "
",
        "fig.show()"
